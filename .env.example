# Cadena de conexión a PostgreSQL
# Local (Docker): postgresql://postgres:postgres@localhost:5432/batch_cooking
# Prod (Supabase): obtener desde Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/batch_cooking"

# Entorno de ejecución
# "dev"  → lee config desde config/dev.json
# cualquier otro valor → lee PLATFORM_CONFIG desde variable de entorno
APP_ENV=dev

# Puerto del servidor HTTP
PORT=8080

# Solo requerido cuando APP_ENV != "dev"
# Formato JSON con credenciales de Supabase, GCP y origen del frontend
# jwksUrl (RS256, proyectos nuevos) o jwtSecret (HS256, legacy) — solo uno de los dos
# PLATFORM_CONFIG={"supabase":{"url":"https://xxxx.supabase.co","jwksUrl":"https://xxxx.supabase.co/auth/v1/.well-known/jwks.json"},"gcp":{"projectId":"...","storageBucket":"..."},"webOrigin":"https://tu-dominio.com"}
